# Required on ANY compatible hosting provider. Never commit the real .env.
ATIA_ADMIN_USER=admin
ATIA_ADMIN_PASSWORD=

# Automatic domain detection is the default. Keep this unset/absent.
# ATIA_PUBLIC_URL=https://panel.example.com

# Hosting providers normally supply PORT; our fallback is 8080.
# PORT=8080
# A writable /data mount is auto-selected; otherwise storage is temporary.
# Override only when your real persistent volume uses a different path.
# ATIA_DATA_DIR=/your-persistent-volume/atiaatashin-data
# ATIA_PERSISTENT_STORAGE=true
